{
  "name": "dptsi/laravel-sso",
  "description": "Laravel authentication package for SSO ITS",
  "type": "library",
  "authors": [
    {
      "name": "DPTSI ITS",
      "email": "developer@its.ac.id"
    }
  ],
  "minimum-stability": "dev",
  "require": {
    "php": "^8.0",
    "laravel/framework": "^8.12|^9.0|^10.0|^11.0|^12.0|^13.0",
    "myits/openid-connect-client": "^1.5.0",
    "ramsey/uuid": "^4.0.0",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": {
      "Dptsi\\Sso\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Dptsi\\Sso\\Providers\\SsoServiceProvider"
      ]
    }
  }
}
